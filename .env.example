# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server/migration only — never expose

# ── Cloudflare R2 (S3-compatible) ────────────────────────────────────
R2_ACCOUNT_ID=<account-id>
R2_ACCESS_KEY_ID=<access-key>
R2_SECRET_ACCESS_KEY=<secret>
R2_BUCKET=tsd-media
R2_PUBLIC_BASE=https://media.tsdmagazine.com   # custom domain on the R2 bucket

# ── Migration source (read-only; used ONLY by scripts/migrate.js) ────
WORDPRESS_API_URL=https://thesuccessdigest.com/wp-json/wp/v2

# ── Email (port from existing service when newsletter automation lands) ─
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=
